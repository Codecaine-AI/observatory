        }
      ],
      "children": []
    },
    "sm-off-lead": {
      "id": "sm-off-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "observatoryModeFromEnv",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "src/server/engine-runs.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "src/server/engine-runs.ts",
              "symbol": "observatoryModeFromEnv"
            }
          }
        },
        {
          "insert": " trims "
        },
        {
          "insert": "OBSERVATORY_MODE",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and reads it at start. An unset or empty value and "
        },
        {
          "insert": "local",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " give local mode, "
        },
        {
          "insert": "server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " gives server mode, and any other value throws. Server mode turns off 10 parts of local mode."
        }
      ],
      "children": []
    },
