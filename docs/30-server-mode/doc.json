    "sm-intro": {
      "id": "sm-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Server mode is the read-only mode of the Observatory API for a shared host, such as services-01. With "
        },
        {
          "insert": "OBSERVATORY_MODE=server",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the API mounts no route that writes, runs a command, or reaches a registry project, and it reads the engine runs from the trace ClickHouse. The UI is the same in both modes. This page gives what server mode turns off, the settings of the services-01 LaunchAgent, and what stays on."
        }
      ],
      "children": []
    },
    "sm-h-off": {
      "id": "sm-h-off",
