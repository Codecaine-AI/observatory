{
  "schemaVersion": 1,
  "id": "viewer-layering",
  "title": "Viewer layering",
  "root": "b-viewer-layering-root-24",
  "blocks": {
    "b-viewer-layering-root-24": {
      "id": "b-viewer-layering-root-24",
      "type": "paragraph",
      "props": {},
      "children": [
        "b-viewer-layering-viewer-functionality-in-2",
        "b-viewer-layering-three-layers-3",
        "b-viewer-layering-layer-0-is-the-shared-vi-4",
        "b-viewer-layering-layer-1-is-the-observato-5",
