    "vl-intro": {
      "id": "vl-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Observatory draws traces with code from 2 repos, in 3 layers. Layer 0 is the trace-viewer repo, layer 1 is Observatory, and layer 2 is a harness extension. This page gives what each layer holds, which layer imports which, where a new feature goes, and what Observatory reads when a harness is offline."
        }
      ],
      "children": []
    },
    "vl-h-layers": {
      "id": "vl-h-layers",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Three Layers"
        }
      ],
      "children": []
    },
    "vl-layers-lead": {
      "id": "vl-layers-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each layer imports only the layers below it. Inside layer 0, read-service also imports viewer-core for "
        },
        {
          "insert": "pushAttr",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Layer 2 has no code today, so the stack draws it with no arrow."
        }
      ],
      "children": []
    },
    "vl-stack": {
      "id": "vl-stack",
      "type": "stack",
      "props": {
        "boundaries": [
          {
            "after": "Layer 2: Harness Extensions",
            "rule": "No Observatory page passes a `detailBlockProvider`. `GET /registry/projects` returns the registry field `extensionPackage`, and no code loads it."
          },
          {
            "after": "Layer 1: Observatory",
            "rule": "Observatory runs no query on `archon.db` or ClickHouse. `createEngineRunPlugins` passes the settings to `createArchonHomeReader` and mounts `createEngineRunRoutes`."
          },
          {
            "after": "Layer 0: trace-viewer",
            "rule": "No agent-kernel package and no prompt-kit package lists a trace-viewer package in its `package.json`."
          }
        ],
        "nodes": [
          {
            "name": "Layer 2: Harness Extensions",
            "color": "gray",
            "children": [
              {
                "name": "No extension today",
                "detail": "no harness ships one"
              }
            ]
          },
          {
            "name": "Layer 1: Observatory",
            "color": "blue",
            "uses": "link:",
            "columns": 2,
            "children": [
              {
                "name": "Pages",
                "badge": "ui",
                "detail": "src/ui/pages/ · `ActionsPage` · `TracesPage` · `RunsPage`"
