        "b-viewer-layering-agents-and-prompt-lab-ar-19",
        "b-viewer-layering-with-the-harness-running-20",
        "b-viewer-layering-an-extension-must-render-21",
        "b-viewer-layering-what-is-deliberately-not-22",
        "b-viewer-layering-the-extensions-v0-overri-23"
      ]
    },
    "b-viewer-layering-viewer-functionality-in-2": {
      "id": "b-viewer-layering-viewer-functionality-in-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Viewer functionality in Observatory has three layers. The boundary is based on whether behavior is common to kernel traces or depends on one harness's application semantics."
        }
      ],
      "children": []
    },
    "b-viewer-layering-three-layers-3": {
      "id": "b-viewer-layering-three-layers-3",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Three layers"
        }
      ],
      "children": []
    },
    "b-viewer-layering-layer-0-is-the-shared-vi-4": {
      "id": "b-viewer-layering-layer-0-is-the-shared-vi-4",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Layer 0 is the shared viewer packages in "
        },
        {
          "insert": "agent-kernel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ": "
        },
        {
          "insert": "viewer-core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "viewer-ui",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and "
        },
        {
          "insert": "viewer-shell",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". They own app-neutral behavior, including the trace tree, span cards, detail shell, generic renderers, and prompt lab. Application-specific behavior must not be hardcoded in these packages. The "
        },
        {
          "insert": "app:board-render",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " detail renderer was moved into Canvas's extension for this reason. The package-boundary check rejects known app-specific references under "
        },
        {
          "insert": "agent-kernel/packages",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-viewer-layering-layer-1-is-the-observato-5": {
      "id": "b-viewer-layering-layer-1-is-the-observato-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Layer 1 is the Observatory host. It owns the project registry, routing, per-project viewer mounting, extension loading, and fallback policy. It does not interpret application events."
        }
      ],
      "children": []
    },
    "b-viewer-layering-layer-2-is-each-harness-6": {
      "id": "b-viewer-layering-layer-2-is-each-harness-6",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Layer 2 is each harness's "
        },
        {
          "insert": "./viewer-extension",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " package. It contains only the additions that depend on that harness's application semantics. In Extensions v0, an extension exports a detail-block provider constructed with "
        },
        {
          "insert": "{ apiBase }",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-viewer-layering-where-a-feature-belongs-7": {
      "id": "b-viewer-layering-where-a-feature-belongs-7",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Where a feature belongs"
        }
      ],
      "children": []
    },
    "b-viewer-layering-the-default-destination-8": {
      "id": "b-viewer-layering-the-default-destination-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The default destination is the shared layer. Rendering for protocol-level events, generic tool calls, prompts, or any other behavior that applies to the traces of any kernel belongs in "
        },
        {
          "insert": "viewer-ui",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "viewer-shell",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with shared data and API contracts in "
        },
        {
          "insert": "viewer-core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-viewer-layering-an-extension-is-reserved-9": {
      "id": "b-viewer-layering-an-extension-is-reserved-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An extension is reserved for application semantics. Canvas board renders and Canvas transcript-backed thinking, program, and render blocks are examples."
        }
      ],
      "children": []
    },
    "b-viewer-layering-when-two-harnesses-need-10": {
      "id": "b-viewer-layering-when-two-harnesses-need-10",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When two harnesses need the same extension behavior, that behavior moves into the shared packages and both extensions remove it. Extensions are not a second general-purpose viewer library."
        }
      ],
      "children": []
    },
    "b-viewer-layering-override-semantics-11": {
      "id": "b-viewer-layering-override-semantics-11",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Override semantics"
        }
      ],
      "children": []
    },
    "b-viewer-layering-extension-detail-block-p-12": {
      "id": "b-viewer-layering-extension-detail-block-p-12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Extension detail-block providers are additive. They contribute blocks to the built-in renderer's blocks. They do not replace the renderer or its view."
        }
      ],
      "children": []
    },
    "b-viewer-layering-block-identifiers-are-un-13": {
      "id": "b-viewer-layering-block-identifiers-are-un-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Block identifiers are unique within a view. When a provider returns the same identifier more than once, the first block wins. When an extension identifier collides with a built-in identifier, the built-in block wins because built-in blocks are merged first."
        }
      ],
      "children": []
    },
    "b-viewer-layering-a-missing-provider-a-pr-14": {
      "id": "b-viewer-layering-a-missing-provider-a-pr-14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A missing provider, a provider that throws, or an extension that cannot be loaded or constructed contributes no extension blocks. Generic rendering continues."
        }
      ],
      "children": []
    },
    "b-viewer-layering-the-shell-orders-blocks-15": {
      "id": "b-viewer-layering-the-shell-orders-blocks-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The shell orders blocks by slot, then explicit order, then identifier. Slot order is "
        },
        {
          "insert": "input",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "content",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "output",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "media",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". For a tabbed detail view, extension blocks are merged only into the first, default tab. Later tabs remain as the built-in renderer declared them."
        }
      ],
      "children": []
    },
    "b-viewer-layering-an-unknown-app-event-16": {
      "id": "b-viewer-layering-an-unknown-app-event-16",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An unknown "
        },
        {
          "insert": "app:*",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " event resolves through the generic span card and generic facts detail renderer. Raw Details remains available."
        }
      ],
      "children": []
    },
    "b-viewer-layering-the-live-offline-split-17": {
      "id": "b-viewer-layering-the-live-offline-split-17",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The live/offline split"
        }
      ],
      "children": []
    },
    "b-viewer-layering-with-observatory-running-18": {
      "id": "b-viewer-layering-with-observatory-running-18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "With Observatory running and a harness down, trace browsing, generic rendering, and blob-backed previews continue from the read-only "
        },
        {
          "insert": "trace.db",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The concrete trace, blob, and turn-context routes are served locally and take precedence over the passthrough."
        }
      ],
      "children": []
    },
    "b-viewer-layering-agents-and-prompt-lab-ar-19": {
      "id": "b-viewer-layering-agents-and-prompt-lab-ar-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Agents and prompt lab are unavailable while the harness is down. Extension enrichment that depends on an application-specific live route is also unavailable. For example, Canvas transcript-backed thinking, program, and render blocks require its transcript route. Failure must remove that enrichment without breaking the generic detail view."
        }
      ],
      "children": []
    },
    "b-viewer-layering-with-the-harness-running-20": {
      "id": "b-viewer-layering-with-the-harness-running-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "With the harness running, catalog access, prompt editing for writable projects, and application-specific routes are available through "
        },
        {
          "insert": "/registry/kernels/:id/kernel/**",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Observatory passes unmatched routes through to the harness."
        }
      ],
      "children": []
    },
    "b-viewer-layering-an-extension-must-render-21": {
      "id": "b-viewer-layering-an-extension-must-render-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An extension must render something useful from "
        },
        {
          "insert": "apiBase",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and data available through the DB-backed routes alone. Data from live-only application routes is progressive enhancement and must degrade to no enrichment rather than an error."
        }
      ],
      "children": []
    },
    "b-viewer-layering-what-is-deliberately-not-22": {
      "id": "b-viewer-layering-what-is-deliberately-not-22",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What is deliberately not overridable in v0"
        }
      ],
      "children": []
    },
    "b-viewer-layering-the-extensions-v0-overri-23": {
      "id": "b-viewer-layering-the-extensions-v0-overri-23",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Extensions v0 override surface is detail blocks only. Span cards, the trace list, overlays, and workspace chrome remain owned by the shared viewer. They become extension surfaces only after a concrete cross-layer need is demonstrated."
        }
      ],
      "children": []
    }
  }
}
