          {
            "name": "Layer 0: trace-viewer",
            "color": "green",
            "uses": "workspace:*",
            "columns": 2,
            "children": [
              {
                "name": "Viewer packages",
                "children": [
                  {
                    "name": "viewer-shell",
                    "detail": "packages/viewer-shell/ · `KernelTraceWorkspace`",
                    "uses": true
                  },
                  {
                    "name": "viewer-ui",
                    "detail": "packages/viewer-ui/ · span cards · detail panel renderers",
                    "uses": true
                  },
                  {
                    "name": "viewer-core",
                    "detail": "packages/viewer-core/ · span types · `buildTraceSpans`"
