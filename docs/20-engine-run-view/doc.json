    "erv-routes": {
      "id": "erv-routes",
      "type": "structured-table",
      "props": {
        "columns": [
          "Route",
          "200 body",
          "Other answers"
        ],
        "rows": [
          [
            [
              {
                "insert": "GET /api/engine-runs",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "{ engine_runs: EngineRunSummary[] }",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ", newest first. A run with no start time is last."
              }
            ],
            "500 on a failed read, 503 on a WAL database with no -wal file"
          ],
          [
            [
              {
                "insert": "GET /api/engine-runs/:engine/:runId",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "{ run: EngineRunSummary, spans: WireTraceSpan[] }",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ". "
              },
              {
                "insert": "spans",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " holds the run span, and the tree is under it. Each time is an ISO 8601 string."
              }
            ],
            "400 on a bad engine or run id, 404 when no store holds the run, 500 on a failed read, 503 on a WAL database with no -wal file"
          ],
          [
            [
              {
                "insert": "GET /api/engine-runs/:engine/:runId/calls/:callId",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "GatewayCallContent",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ": the tags, outcome, start, model, effort, prompt, answer, usage and the partial flag of one call"
              }
            ],
            "400 on a bad id or a call id that is not a UUID, 404 when the run holds no such call, 501 when no gateway is set, 500 on a failed ClickHouse read"
