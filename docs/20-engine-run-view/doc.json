    "erv-intro": {
      "id": "erv-intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The Runs page of Observatory shows one run of a workflow engine as a tree, from the run down to each model call. It draws the tree in "
        },
        {
          "insert": "KernelTraceWorkspace",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the same workspace as the Traces page. The read service of the trace-viewer repo builds the tree from 3 stores, joined on the 6 trace tags. This page gives the screen, the tree rules, the detail panels, the routes, the settings and the known limits."
        }
      ],
      "children": []
    },
    "erv-h-screen": {
      "id": "erv-h-screen",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "The Screen"
        }
      ],
      "children": []
    },
    "erv-screen-lead": {
      "id": "erv-screen-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The list at "
        },
        {
          "insert": "/runs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " shows the runs of the Archon home, newest first, with the workflow name, the engine, the short run id, the local start time and the status. A click opens the run at "
        },
        {
          "insert": "/runs/:engine/:runId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with the tree on the left and the detail panel of the selected row on the right. The 3 screenshots show run c5993f42 of the pre-pr-review workflow."
        }
      ],
      "children": []
    },
    "erv-img-tree": {
