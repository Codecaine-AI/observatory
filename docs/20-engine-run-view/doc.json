    "erv-display": {
      "id": "erv-display",
      "type": "structured-table",
      "props": {
        "columns": [
          "Fact",
          "How the view shows it"
        ],
        "rows": [
          [
            "Cost",
            "No row and no panel shows a cost, because no store gives a cost for every node or a run total."
          ],
          [
            "Times",
            [
              {
                "insert": "A call row shows its start time in UTC as "
              },
              {
                "insert": "HH:MM:SS",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ". A detail panel and the Details view show a UTC date and time with the zone name. Each one shows the local time of the browser in its tooltip. The run list shows the local start time."
              }
            ]
          ],
          [
            "Call duration",
            "A call shows a start time and no duration, because a gateway row has no end time."
          ],
          [
            "Token counts",
            "Cached input tokens and cache write tokens each have their own line. Each count keeps the provider's meaning, so an Anthropic input count leaves out cached tokens and an OpenAI input count holds them."
          ],
          [
            "Model names",
            "The Usage block shows the model of the request, and the response model only when it differs. A tree row shows no model."
          ],
          [
            "Helper calls",
            "A native node lists each served call in time order, such as a session-title call or a summary call. The served-call rule filters only on the outcome and the response id."
          ],
          [
            "Decide node",
            [
              {
                "insert": "When the gateway adapter answered, the node shows "
              },
              {
                "insert": "0 calls",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": ". It also shows its kernel spans, its decision card, and "
              },
              {
                "insert": "decide → <choice>",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " beside its name when the node output names the choice."
              }
            ]
          ],
          [
            "Outcome",
            [
              {
                "insert": "A call shows its outcome as the store holds it. An empty outcome reads "
              },
              {
                "insert": "(empty)",
                "attributes": {
