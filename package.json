{
  "name": "@codecaine-ai/observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "api": "bun run src/server/index.ts",
    "ui": "bunx --bun vite --config src/ui/vite.config.ts",
    "test": "bun test",
    "typecheck": "bunx --bun tsc -p tsconfig.json --noEmit",
    "registry:check": "bun scripts/sync-registry.ts --check",
    "registry:sync": "bun scripts/sync-registry.ts --write"
  },
  "dependencies": {
    "@agent-kernel/db": "link:@agent-kernel/db",
    "@agent-kernel/kernel": "link:@agent-kernel/kernel",
    "@agent-kernel/protocol": "link:@agent-kernel/protocol",
    "@agent-kernel/viewer-core": "link:@agent-kernel/viewer-core",
    "@agent-kernel/viewer-shell": "link:@agent-kernel/viewer-shell",
    "@agent-kernel/viewer-ui": "link:@agent-kernel/viewer-ui",
    "@codecaine-ai/canvas-agent": "link:@codecaine-ai/canvas-agent",
    "@codecaine-ai/prompt-kit": "link:@codecaine-ai/prompt-kit",
    "elysia": "^1.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.0"
  }
}
